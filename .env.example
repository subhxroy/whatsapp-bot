# Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Security & Encryption Keys
# Generate 32-byte hex string (64 chars) for AES-256-GCM session & token encryption
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes_minimum

# Firebase (Firestore)
# Path to the service account JSON key downloaded from Firebase console
# (Project settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# Alternative: inline JSON value via FIREBASE_SERVICE_ACCOUNT, or GOOGLE_APPLICATION_CREDENTIALS.
# Local emulator only: set FIREBASE_PROJECT_ID=<project-id> and FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=""

# Firebase Web SDK config (dashboard Google sign-in)
# Copy the firebaseConfig block from Firebase console > Project settings > General > Your apps
# MUST be the same project as the service account above for ID-token verification.
# IMPORTANT: Next.js only reads NEXT_PUBLIC_* from the web app's own .env — also put these in apps/web/.env.local
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Redis Configuration (BullMQ & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Privacy Defaults (Mandatory)
MESSAGE_LOGGING=false
AI_ENABLED=false
MEDIA_RETENTION=temporary
ANALYTICS=false
THIRD_PARTY_TRACKING=false

# Bot Owner Configuration (Format: 1234567890@s.whatsapp.net or digits only)
# SECURITY: authoritative value is stored via the dashboard in Firestore
# (settings/BOT_OWNER_NUMBER). This env var is only a bootstrap fallback and
# defaults to empty so that a missing owner config FAILS CLOSED.
BOT_OWNER_NUMBER=""

# Optional AI Providers (disabled by default via AI_ENABLED=false)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OLLAMA_BASE_URL="http://localhost:11434"
