{
  "name": "@private-md-bot/whatsapp",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external firebase-admin",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external firebase-admin",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "@private-md-bot/config": "workspace:*",
    "@private-md-bot/database": "workspace:*",
    "@private-md-bot/security": "workspace:*",
    "firebase-admin": "^13.4.0",
    "pino": "^9.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
